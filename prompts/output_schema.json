{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ZeroTouchStrategistOutput",
  "type": "object",
  "required": [
    "linkedin_post",
    "facebook_post",
    "instagram_post",
    "image_gen_prompt",
    "image_description"
  ],
  "properties": {
    "linkedin_post": { "type": "string", "minLength": 10 },
    "facebook_post": { "type": "string", "minLength": 10 },
    "instagram_post": { "type": "string", "minLength": 10 },
    "image_gen_prompt": { "type": ["string", "null"] },
    "image_description": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}