# ============================================================================
# ZERO-TOUCH SOCIAL AUTOMATION - ENVIRONMENT TEMPLATE (.env.example)
# ============================================================================

# --- 1. N8N DEPLOYMENT & WEBHOOK CONFIG ---
DEPLOY_TARGET=render_free
PORT=5678
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_HOST=your-n8n-instance.onrender.com
WEBHOOK_URL=https://your-n8n-instance.onrender.com/
GENERIC_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata

# --- 2. N8N SECURITY & EXECUTION PRUNING ---
N8N_ENCRYPTION_KEY=replace_with_32_byte_hex_key
N8N_USER_MANAGEMENT_JWT_SECRET=replace_with_32_byte_hex_secret
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=72
EXECUTIONS_DATA_PRUNE_MAX_COUNT=500

# --- 3. DATABASE PERSISTENCE (SUPABASE POSTGRES) ---
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=postgres
DB_POSTGRESDB_USER=postgres.your_project_ref
DB_POSTGRESDB_PASSWORD=your_database_password
DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=false

# --- 4. GOOGLE SHEETS CONFIG ---
GOOGLE_SHEET_DOCUMENT_ID=your_google_sheet_document_id
GOOGLE_SHEET_TAB_NAME=Content_Pipeline

# --- 5. CREATIVE DIRECTOR & COPYWRITING AI (OPENROUTER) ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# --- 6. EXCLUSIVE POSTER ARTWORK ENGINE (AIROUTER NANO BANANA 2.1) ---
AIROUTER_API_KEY=sk-air-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AIROUTER_BASE_URL=https://api.airouter.in/v1
AIROUTER_IMAGE_MODEL=google/gemini-nano-banana-2.1
AIROUTER_TIMEOUT_SECONDS=420

# --- 7. PUBLIC IMAGE HOSTING (IMGBB) ---
IMGBB_API_KEY=your_imgbb_api_key

# --- 8. BUFFER GRAPHQL MULTI-CHANNEL PUBLISHER ---
BUFFER_API_KEY=your_buffer_api_key
BUFFER_PUBLISH_IMMEDIATELY=true
DRIP_FEED_CRON_SCHEDULE=*/45 * * * *
DRIP_FEED_MAX_BATCH_SIZE=2

# --- 9. INSTAGRAM REFERENCE SCRAPER AUTH (OPTIONAL) ---
IG_USERNAME=your_burner_ig_username
IG_PASSWORD=your_burner_ig_password